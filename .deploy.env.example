## Deployment configuration (copy this to .deploy.env and fill values)

# Remote server
SSH_HOST=91.107.178.13
SSH_USER=root

# One of the following auth methods:
# 1) SSH key (recommended)
# SSH_KEY_PATH=~/.ssh/ieee_ci
# SSH_PASSPHRASE= # if your key has a passphrase

# 2) Password (requires sshpass locally)
# SSH_PASS=your_server_password_here

# Optional host verification (recommended for CI)
# SSH_FINGERPRINT=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... (output of ssh-keyscan | ssh-keygen -lf - -E sha256)

# Remote path and PM2 app name
DEPLOY_PATH=/opt/ieee-website
PM2_APP_NAME=IEEE-website
