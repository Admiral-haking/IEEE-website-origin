# Copy to `.env.local` and fill values

# Database
MONGODB_URI=mongodb://localhost:27017/ieee

# Auth
JWT_SECRET=replace-with-a-long-random-string
# If true, the very first registered account can become admin automatically.
# For better security in production, leave this false and create admins manually.
ALLOW_FIRST_ADMIN_SIGNUP=false

# Public URLs
# Base URL that the browser uses to talk to this app (must match your reverse proxy / production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional separate API base if you proxy /api to a different host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional: Redis cache
# REDIS_URL=redis://localhost:6379

# SMTP (email)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=ieee@example.com
MAIL_TO=owner@example.com

# Feature flags
# Assist widget (client)
NEXT_PUBLIC_ENABLE_ASSIST=false
# Web Vitals reporter (client)
NEXT_PUBLIC_ENABLE_VITALS=true
# Web Vitals API/storage (server)
OPS_VITALS_ENABLED=true
# Email notifications (server). Set to 0/false to disable.
NOTIFICATIONS_EMAIL_ENABLED=true
# Chat feature (server disable flag and client nav hide flag)
CHAT_DISABLED=false
NEXT_PUBLIC_DISABLE_CHAT=false

# Captcha (optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY= # if using Cloudflare Turnstile widget on client
# TURNSTILE_SECRET_KEY=           # secret key for server-side verify
# HCAPTCHA_SECRET=                # alternative provider

# Optional: AI integrations
# Use real keys only in .env.local (never commit real secrets).
OPENAI_API_KEY=your-openai-api-key
# Base URLs for AI providers (used by CSP and server calls)
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: OpenAI image model for news images
# OPENAI_IMAGE_MODEL=gpt-image-1

# AI_API_KEY= # generic provider key
# AI_MODERATION_URL=https://your-ai.example.com/moderate

# Security hardening
# If true, apply stricter rate limits / captcha for foreign or VPN IPs (based on cf-ipcountry / x-vercel-ip-country headers).
# SEC_STRICT_FOREIGN_IP=false
# Two-letter country code treated as "local" (default IR).
# LOCAL_COUNTRY_CODE=IR

# Content Security Policy profile
# dev      → relaxed for local dev (inline/eval allowed)
# standard → safe defaults (inline scripts allowed, no eval) [default in production]
# strict   → strongest (no inline scripts/eval; may require extra tuning)
#CSP_LEVEL=standard

# Telegram bot (optional)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
# TELEGRAM_ALLOWED_CHAT_ID=123456789
